<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>
  <!-- Long run of the artery (mesh of ../artery_dan) with the smooth-muscle
       element in all seven regions (see README): pressure ramped to 85 mmHg
       over the first second, reorientation, growth and, in the media, the
       active response switched by time segments, and a drug concentration of
       2 on the inner and outer walls from t = 4660.0. -->
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <!-- Every segment gives its own <Save_results_every_time>: the phases of
       this run differ too much for one interval. The interval is chosen from
       what the phase does, not from its step size: 0.1 s over the 1 s
       pressure ramp, 10 s over the 300 s of growth, 50 s over the long
       phases. In the 4000 s active phase 50 s samples the contraction
       closely while the step is still small and then falls back to one file
       per step as the step grows, which is the transient sampled finely and
       the steady state coarsely. About 74 files in all. -->
  <Add_time_step_segment> <Start_time> 0. </Start_time> <Time_step_size> 0.02 </Time_step_size> <Save_results_every_time> 0.1 </Save_results_every_time> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 1. </Start_time> <Time_step_size> 5.0 </Time_step_size> <Save_results_every_time> 5.0 </Save_results_every_time> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 20. </Start_time> <Time_step_size> 500 </Time_step_size> <Save_results_every_time> 50.0 </Save_results_every_time> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4020. </Start_time> <Time_step_size> 5.0 </Time_step_size> <Save_results_every_time> 5.0 </Save_results_every_time> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4040. </Start_time> <Time_step_size> 100 </Time_step_size> <Save_results_every_time> 50.0 </Save_results_every_time> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4340. </Start_time> <Time_step_size> 0.05 </Time_step_size> <Save_results_every_time> 10.0 </Save_results_every_time> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4640. </Start_time> <Time_step_size> 5.0 </Time_step_size> <Save_results_every_time> 5.0 </Save_results_every_time> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4660. </Start_time> <Time_step_size> 100 </Time_step_size> <Save_results_every_time> 50.0 </Save_results_every_time> </Add_time_step_segment>
  <Final_time> 5300 </Final_time>
  <!-- Adaptive time stepping: the size given for a segment above is the
       largest step that segment may take. A time step that fails (the
       element cannot compute its state, the linear solver breaks down, or
       the Newton iteration reaches <Max_iterations> without converging) is
       repeated from the state it started from with half the step, down to
       1e-4, and after 25 time steps in a row that converge the step is
       doubled again, up to the segment's size. The growth segment holds
       0.05, which is what the element turned out to allow. Jobs 6489988 and
       6489989 were given 25 s there: both took it as their first growth
       step, failed, and halved their way down to 0.0586 and 0.0488, where
       they stayed, at the cost of 92 and 124 repeated steps. So the 0.025 s
       the segment held originally was conservative by a factor of two, not
       by the factor of a thousand that the earlier absence of recorded
       growth failures had suggested. Growing back after 25 converged steps
       rather than 5 keeps the probe that would find a larger step if the
       physics allowed one, at a fifth of the wasted solves. -->
  <Adaptive_time_stepping> true </Adaptive_time_stepping>
  <Minimum_time_step_size> 1e-4 </Minimum_time_step_size>
  <Converged_time_steps_before_increase> 25 </Converged_time_steps_before_increase>
  <!-- Spectral radius 0: alpha_f = 1, so the element and the loads are
       evaluated at t_{n+1} as in FEDDLib; without inertia, alpha_f < 1 would
       enforce equilibrium at the intermediate state t_{n+alpha_f}. -->
  <Spectral_radius_of_infinite_time_step> 0.0 </Spectral_radius_of_infinite_time_step>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Save_results_in_XDMF_format> true </Save_results_in_XDMF_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <!-- The results are written by simulated time, not by step count: the step
       size spans four orders of magnitude here, so a step count is a poor
       measure of a run. The growth phase is 99 % of the time steps and 6 % of
       the time; every 100th step wrote nothing at all of the active phase,
       and every step wrote 7 MB x 12000 steps of growth. The interval is the
       one given for each time step segment above; a run-wide
       <Save_results_every_time> would be the fallback for a segment that
       gives none. -->
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>

  <!-- Restart files (with the element history) every 500 steps, kept as
       stFile_<step>.bin: continue with <Continue_previous_simulation> true
       and the same number of processes (see README). -->
  <Increment_in_saving_restart_files> 500 </Increment_in_saving_restart_files>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>

</GeneralSimulationParameters>

