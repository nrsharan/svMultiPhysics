<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>
  <!-- Long run of the artery (mesh of ../artery_dan) with the constrained-mixture
       element in all seven regions (see README): pressure ramped to 85 mmHg
       over the first second, reorientation, growth and, in the media, the
       active response switched by time segments, and a drug concentration of
       2 on the inner and outer walls from t = 4660.0. -->
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <!-- Pressure ramp in steps of 0.05, ten times the 0.005 of the earlier
       schedule: with the corrected elements the larger steps are to be
       tried, and adaptive time stepping halves the ones that fail. Growth
       switches on at 4340.01 rather than at the segment's start, where the
       element's growth iteration diverged in the earlier schedule. -->
  <Add_time_step_segment> <Start_time> 0. </Start_time> <Time_step_size> 0.05 </Time_step_size> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 1. </Start_time> <Time_step_size> 5.0 </Time_step_size> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 20. </Start_time> <Time_step_size> 500 </Time_step_size> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4020. </Start_time> <Time_step_size> 5.0 </Time_step_size> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4040. </Start_time> <Time_step_size> 100 </Time_step_size> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4340. </Start_time> <Time_step_size> 0.25 </Time_step_size> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4640. </Start_time> <Time_step_size> 5.0 </Time_step_size> </Add_time_step_segment>
  <Add_time_step_segment> <Start_time> 4660. </Start_time> <Time_step_size> 100 </Time_step_size> </Add_time_step_segment>
  <Final_time> 5300 </Final_time>
  <!-- Adaptive time stepping: the size given for a segment above is the
       largest step that segment may take. A time step that fails (the
       element cannot compute its state, the linear solver breaks down, or
       the Newton iteration reaches <Max_iterations> without converging) is
       repeated from the state it started from with half the step, down to
       1e-4, and after 5 time steps
       in a row that converge the step is doubled again, up to the segment's
       size. The first load step and the switch-on of growth, which this
       case works around with a smaller pressure ramp step and growth at
       4340.01, are both of that kind. -->
  <Adaptive_time_stepping> true </Adaptive_time_stepping>
  <Minimum_time_step_size> 1e-4 </Minimum_time_step_size>
  <!-- Spectral radius 0: alpha_f = 1, so the element and the loads are
       evaluated at t_{n+1} as in FEDDLib; without inertia, alpha_f < 1 would
       enforce equilibrium at the intermediate state t_{n+alpha_f}. -->
  <Spectral_radius_of_infinite_time_step> 0.0 </Spectral_radius_of_infinite_time_step>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Save_results_in_XDMF_format> true </Save_results_in_XDMF_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 1 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>

  <!-- Restart files (with the element history) every 500 steps, kept as
       stFile_<step>.bin: continue with <Continue_previous_simulation> true
       and the same number of processes (see README). -->
  <Increment_in_saving_restart_files> 100 </Increment_in_saving_restart_files>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>

</GeneralSimulationParameters>

