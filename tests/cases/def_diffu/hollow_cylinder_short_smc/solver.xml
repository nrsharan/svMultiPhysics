<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>
  <!-- Short regression case (tests/test_def_diffu.py) for the smooth-muscle
       element (<CCBActiveGandR>): hollow_cylinder_short with this element and
       its hollow-cylinder parameter set, reorientation, growth (growth
       orientation initialized when it switches on) and the active response
       (active stretches initialized; ActiveStartTime 1.6) switched on within
       ten steps, the rate parameters accelerated by a factor 20 until t = 1,
       and a concentration Dirichlet condition on both walls. -->
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> 10 </Number_of_time_steps>
  <Time_step_size> 0.2 </Time_step_size>
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 10 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>

  <Increment_in_saving_restart_files> 1000 </Increment_in_saving_restart_files>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>

</GeneralSimulationParameters>

<Add_mesh name="msh" >
  <Mesh_file_path> ../hollow_cylinder/mesh/mesh-complete.mesh.vtu </Mesh_file_path>

  <Add_face name="bottom">
      <Face_file_path> ../hollow_cylinder/mesh/mesh-surfaces/bottom.vtp </Face_file_path>
  </Add_face>

  <Add_face name="top">
      <Face_file_path> ../hollow_cylinder/mesh/mesh-surfaces/top.vtp </Face_file_path>
  </Add_face>

  <Add_face name="outer">
      <Face_file_path> ../hollow_cylinder/mesh/mesh-surfaces/outer.vtp </Face_file_path>
  </Add_face>

  <Add_face name="inner">
      <Face_file_path> ../hollow_cylinder/mesh/mesh-surfaces/inner.vtp </Face_file_path>
  </Add_face>

  <Add_face name="pin0">
      <Face_file_path> ../hollow_cylinder/mesh/mesh-surfaces/pin0.vtp </Face_file_path>
  </Add_face>

  <Add_face name="pin1">
      <Face_file_path> ../hollow_cylinder/mesh/mesh-surfaces/pin1.vtp </Face_file_path>
  </Add_face>

  <Add_face name="pin2">
      <Face_file_path> ../hollow_cylinder/mesh/mesh-surfaces/pin2.vtp </Face_file_path>
  </Add_face>

  <Mesh_scale_factor> 1.0 </Mesh_scale_factor>
</Add_mesh>

<Add_equation type="deformation-diffusion" >

   <Coupled> true </Coupled>
   <Min_iterations> 1 </Min_iterations>
   <Max_iterations> 25 </Max_iterations>
   <Tolerance> 1e-5 </Tolerance>

   <Integration_code> 18 </Integration_code>
   <Subiteration_tolerance> 1e-7 </Subiteration_tolerance>

   <CCBActiveGandR>
     <fA> 30. </fA>
     <LambdaC50> 1.2 </LambdaC50>
     <Gamma3Max> 0.9 </Gamma3Max>
     <LambdaBarCDotMax> 0.0443 </LambdaBarCDotMax>
     <LambdaBarCDotMin> -0.0443 </LambdaBarCDotMin>
     <Gamma2> 50.0 </Gamma2>
     <Gamma1Max> 0.5131 </Gamma1Max>
     <Eta> 0.1624 </Eta>
     <Ca50> 0.4 </Ca50>
     <K3> 0.134 </K3>
     <K4> 0.00166 </K4>
     <K7> 0.66e-4 </K7>
     <Kappa> 103.783 </Kappa>
     <Beta1> 0.00100 </Beta1>
     <MuA> 11.857 </MuA>
     <Beta2> 26.68 </Beta2>
     <Alpha2> 151.73775 </Alpha2>
     <Alpha3> 2.75662 </Alpha3>
     <Alpha1> 11.52507 </Alpha1>
     <Alpha4> 1.27631 </Alpha4>
     <Alpha5> 3.08798 </Alpha5>
     <Gamma6> 1.5 </Gamma6>
     <LambdaP50> 1.0 </LambdaP50>
     <KDotMin> -0.0010694 </KDotMin>
     <Zeta1> 10. </Zeta1>
     <KDotMax> 0.0009735 </KDotMax>
     <Gamma4> 200. </Gamma4>
     <LambdaBarDotPMin> -0.0002323 </LambdaBarDotPMin>
     <LambdaBarDotPMax> 0.0000699 </LambdaBarDotPMax>
     <Gamma5> 50. </Gamma5>
     <Zeta2> 100. </Zeta2>
     <DeltaLambdaBarPMin> -1.e-5 </DeltaLambdaBarPMin>
     <Gamma1Min> 0.07797910389823641 </Gamma1Min>
     <Gamma3Min> 0.13677878297366072 </Gamma3Min>
     <C50> 0.6673453235597163 </C50>
     <D0> 7.e-3 </D0>
     <M> 0. </M>
     <ActiveStartTime> 1.6 </ActiveStartTime>
     <kEtaPlus> 0.001 </kEtaPlus>
     <mEtaPlus> 5.0 </mEtaPlus>
     <KThetaPlus> 1.e-5 </KThetaPlus>
     <KThetaMinus> 1.e-5 </KThetaMinus>
     <MThetaPlus> 3.0 </MThetaPlus>
     <MThetaMinus> 3.0 </MThetaMinus>
     <ThetaPlus1> 1.00506 </ThetaPlus1>
     <ThetaPlus2> 1.0206 </ThetaPlus2>
     <ThetaPlus3> 1.11992 </ThetaPlus3>
     <ThetaMinus1> 0.98 </ThetaMinus1>
     <ThetaMinus2> 0.98 </ThetaMinus2>
     <ThetaMinus3> 0.98 </ThetaMinus3>
     <KMin> 0.015 </KMin>
     <ActiveBool> 0 </ActiveBool>
     <growthBool> 0 </growthBool>
     <reorientationBool> 0 </reorientationBool>
     <growthDirectionBool> 1 </growthDirectionBool>
     <kFiberDistribution> 0.1333333333334 </kFiberDistribution>
     <P> 2.9580835205796716 </P>
     <Density> 1.e0 </Density>
     <PostProcessingType> 1. </PostProcessingType>
     <PostProcessingPower> 1. </PostProcessingPower>
     <Time_segments parameter="reorientationBool">
       <Add_interval> <Start_time> 0.4 </Start_time> <End_time> 1.2 </End_time> </Add_interval>
     </Time_segments>
     <Time_segments parameter="growthBool" initialization="growth_orientation">
       <Add_interval> <Start_time> 1.2 </Start_time> <End_time> 1.6 </End_time> </Add_interval>
     </Time_segments>
     <Time_segments parameter="ActiveBool" initialization="active_stretches">
       <Add_interval> <Start_time> 1.6 </Start_time> <End_time> 10000.0 </End_time> </Add_interval>
     </Time_segments>
     <Rate_acceleration>
       <End_time> 1.0 </End_time>
       <Factor> 20.0 </Factor>
       <Multiplied_parameters> LambdaBarCDotMax LambdaBarCDotMin Eta K3 K4 K7 Beta1 Gamma6 KDotMin KDotMax LambdaBarDotPMin LambdaBarDotPMax </Multiplied_parameters>
       <Divided_parameters> Gamma2 Gamma5 </Divided_parameters>
     </Rate_acceleration>
   </CCBActiveGandR>

   <Output type="Spatial" >
     <Displacement> true </Displacement>
     <Concentration> true </Concentration>

     <!-- Post-processing quantities of the Interface2/AceGen element (its
          Post-processing task, averaged to the nodes), by element name.
          SCirc, SAxial and SRadial are the principal Cauchy stresses, largest
          to smallest: -->
     <MisesStress> true </MisesStress>
     <SCirc> true </SCirc>
     <SAxial> true </SAxial>
     <SRadial> true </SRadial>
     <W> true </W>
     <Growth> true </Growth>
     <Stretch1> true </Stretch1>
     <Stretch2> true </Stretch2>
     <nC1> true </nC1>
     <nC2> true </nC2>
     <nD1> true </nD1>
     <nD2> true </nD2>
     <DetF> true </DetF>
     <DetFe> true </DetFe>
     <DetFg> true </DetFg>
     <S> true </S>
     <a1> true </a1>
     <a2> true </a2>
     <Ag1n> true </Ag1n>
     <Ag2n> true </Ag2n>
     <Ag3n> true </Ag3n>
   </Output>

   <LS type="GMRES" >
      <Linear_algebra type="trilinos" >
         <Preconditioner> trilinos-amesos2 </Preconditioner>
      </Linear_algebra>
      <Tolerance> 1e-6 </Tolerance>
      <Max_iterations> 100 </Max_iterations>
      <Krylov_space_dimension> 50 </Krylov_space_dimension>
   </LS>

   <Add_BC name="bottom" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 0, 1) </Effective_direction>
   </Add_BC>

   <Add_BC name="top" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 0, 1) </Effective_direction>
   </Add_BC>

   <Add_BC name="pin0" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 1, 0) </Effective_direction>
   </Add_BC>

   <Add_BC name="pin1" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (1, 0, 0) </Effective_direction>
   </Add_BC>

   <Add_BC name="pin2" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 1, 0) </Effective_direction>
   </Add_BC>

   <Add_BC name="inner" >
      <Type> Neu </Type>
      <Time_dependence> Unsteady </Time_dependence>
      <Temporal_values_file_path> ../hollow_cylinder/load.dat </Temporal_values_file_path>
      <Ramp_function> true </Ramp_function>
      <Follower_pressure_load> true </Follower_pressure_load>
   </Add_BC>

   <Add_BC name="inner" >
      <Type> Dir </Type>
      <Effective_direction> (0, 0, 0, 1) </Effective_direction>
      <Time_dependence> Unsteady </Time_dependence>
      <Temporal_values_file_path> ../hollow_cylinder_short/conc.dat </Temporal_values_file_path>
      <Ramp_function> true </Ramp_function>
   </Add_BC>

   <Add_BC name="outer" >
      <Type> Dir </Type>
      <Effective_direction> (0, 0, 0, 1) </Effective_direction>
      <Time_dependence> Unsteady </Time_dependence>
      <Temporal_values_file_path> ../hollow_cylinder_short/conc.dat </Temporal_values_file_path>
      <Ramp_function> true </Ramp_function>
   </Add_BC>

</Add_equation>

</svMultiPhysicsFile>
