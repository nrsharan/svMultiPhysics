<Add_equation type="deformation-diffusion" >

   <Coupled> true </Coupled>
   <Min_iterations> 1 </Min_iterations>
   <Max_iterations> 25 </Max_iterations>
   <Tolerance> 1e-5 </Tolerance>

   <Integration_code> 18 </Integration_code>
   <Subiteration_tolerance> 1e-7 </Subiteration_tolerance>

   <CCBActiveCMMGandR>
     <fA> 30 </fA>
     <kEtaPlus> 0.6 </kEtaPlus>
     <mEtaPlus> 5 </mEtaPlus>
     <Alpha1> 11.52507 </Alpha1>
     <Alpha2> 151.73775 </Alpha2>
     <Alpha3> 2.75662 </Alpha3>
     <Alpha4> 1.27631 </Alpha4>
     <Alpha5> 3.08798 </Alpha5>
     <GroundGrowthBool> 0 </GroundGrowthBool>
     <ReorientationBool> 0 </ReorientationBool>
     <CollRemodelingBool> 0 </CollRemodelingBool>
     <Density> 1 </Density>
     <ElastinFrac> 0.370370370 </ElastinFrac>
     <CollagenFrac> 0.370370370 </CollagenFrac>
     <TElastin> 1000 </TElastin>
     <TCollagen> 1000 </TCollagen>
     <KElastin> 1 </KElastin>
     <KCollagen> 1 </KCollagen>
     <IHomo> 50 </IHomo>
     <QMax> 1 </QMax>
     <QMin> 0.2 </QMin>
     <AlphaMech> 1 </AlphaMech>
     <PCirc> 1 </PCirc>
     <PAx> 1 </PAx>
     <PRad> 1 </PRad>
     <GNInit> 1.008 </GNInit>
     <TC> 1000 </TC>
     <LambdaC50> 1.2 </LambdaC50>
     <Gamma3Max> 0.9 </Gamma3Max>
     <LambdaBarCDotMax> 0.0443 </LambdaBarCDotMax>
     <LambdaBarCDotMin> -0.0443 </LambdaBarCDotMin>
     <Gamma2> 50 </Gamma2>
     <Gamma1Max> 0.5131 </Gamma1Max>
     <Eta> 0.1624 </Eta>
     <Ca50> 0.4 </Ca50>
     <K3> 0.134 </K3>
     <K4> 0.00166 </K4>
     <K7> 6.6e-05 </K7>
     <Kappa> 148.262 </Kappa>
     <Beta1> 0.001006 </Beta1>
     <MuA> 11.857 </MuA>
     <Beta2> 26.68 </Beta2>
     <Gamma6> 1.5 </Gamma6>
     <LambdaP50> 1 </LambdaP50>
     <KDotMin> -0.0010694 </KDotMin>
     <Zeta1> 100 </Zeta1>
     <KDotMax> 0.0009735 </KDotMax>
     <Gamma4> 200 </Gamma4>
     <LambdaBarDotPMin> -0.0002323 </LambdaBarDotPMin>
     <LambdaBarDotPMax> 6.99e-05 </LambdaBarDotPMax>
     <Gamma5> 50 </Gamma5>
     <Zeta2> 1000 </Zeta2>
     <DeltaLambdaBarPMin> -1e-05 </DeltaLambdaBarPMin>
     <Gamma1Min> 0.0779791039 </Gamma1Min>
     <Gamma3Min> 0.136778783 </Gamma3Min>
     <C50> 0.6673453236 </C50>
     <D0> 6e-05 </D0>
     <M> 0 </M>
     <ActiveStartTime> 1000 </ActiveStartTime>
     <KMin> 0.15 </KMin>
     <ActiveBool> 0 </ActiveBool>
     <kFiberDistribution> 0.1333333333 </kFiberDistribution>
     <P> 2.958083521 </P>
     <TSMC> 1000 </TSMC>
     <SMCFrac> 0.259259259 </SMCFrac>
     <NCOpt> 0.6 </NCOpt>
     <AlphaBio> 1 </AlphaBio>
     <KSMC> 1 </KSMC>
     <SMCGrowthBool> 0 </SMCGrowthBool>
     <PostProcessingType> 1 </PostProcessingType>
     <PostProcessingPower> 1 </PostProcessingPower>
   </CCBActiveCMMGandR>

   <Output type="Spatial" >
     <Displacement> true </Displacement>
     <Concentration> true </Concentration>
   </Output>

   <!-- FSILS's own "rcs" preconditioner (diagonal row/column scaling) was
        verified to reduce this system's raw condition number from ~1.3e9
        to ~4.5e5, still far too large for GMRES within a practical
        iteration budget. "trilinos-ml" (MueLu AMG) genuinely engaged
        (confirmed via its own verbose parameter dump) but still didn't
        converge in 100 iterations. Root cause: svMultiPhysics assembles
        this equation as a single monolithic matrix with dof=4 interleaved
        per node (u1,v1,w1,c1,u2,...), not as separate Kuu/Kuc/Kcu/Kcc
        blocks (confirmed directly in trilinos_lhs_create's globalDofGIDs
        construction), so MueLu's "number of equations"=4 amalgamation
        wrongly assumes all 4 dof/node are of uniform physical type when
        building aggregates/nullspace; wrong here, since Kuc/Kcu are
        exactly zero for this passive test (all active/growth/
        reorientation mechanisms off) and dof 0-2 (elastic, translational
        nullspace) share nothing with dof 3 (unrelated scalar diffusion).
        "trilinos-ilut" (tried next) was worse, not better; ILU's local
        factorization has no multilevel correction, so it handled the
        ~8-9 order-of-magnitude scale gap between the two blocks even
        worse than AMG did. Switched to "trilinos-blockjacobi-uc": a
        custom, genuinely block-structured preconditioner (see
        BlockJacobiUCTpetraOperator / setBlockJacobiUCPreconditioner in
        trilinos_impl.h/.cpp) that extracts the true u (3 elastic dof/
        node) and c (1 concentration dof/node) sub-matrices and applies
        MueLu (now with the physically correct "number of equations"=3)
        to u and simple Gauss-Seidel to c independently; exact, not
        approximate, block-Jacobi given Kuc=Kcu=0 here. Still stalled at
        100 GMRES iterations, so checked what FEDDLib itself actually uses
        for the equivalent structure/chemistry system: not MueLu/AMG at
        all, but FROSch, a two-level overlapping Schwarz method with EXACT
        local subdomain solves (Pardiso) at both the local overlapping
        level and the coarse (rotation-aware RGDSW) level, a
        substantially stronger preconditioner class than anything tried
        here so far. As a fast, decisive check of whether the assembled
        matrix/RHS are themselves sound, independent of preconditioner
        quality, switched to "trilinos-amesos2": an exact direct
        factorization (Amesos2/KLU2, already linked in via MueLu's own
        coarse solve) wrapped as a Tpetra_Operator "preconditioner", so
        GMRES should converge in essentially one iteration if the linear
        system itself is correct. This equation's test meshes are small (a
        few thousand dof), so a direct solve is cheap here; this is a
        validation step, not a scalable choice for larger meshes. That
        validation step worked (iterations 1-1/1-2 solved to machine
        precision in 1 GMRES iteration each), but Newton then diverged on
        iteration 1-3 (an undamped full Newton step overshot into an
        unphysical state) and the matrix went singular by 1-5. Before
        concluding this is purely a missing-line-search issue, switching
        BACK to "fsils"/"rcs" here temporarily, not because rcs is a
        better preconditioner, but to reuse the existing
        DUMP_LINEAR_SYSTEM_CALL/DUMP_LINEAR_SYSTEM_DIR env-var hook
        already in FsilsLinearAlgebra.cpp::solve() to dump the raw
        assembled K/R for a direct, 1:1 comparison against FEDDLib's own
        assembled system at the same physical state (first Newton
        iteration, first load step). Assembly happens identically
        upstream of whichever backend actually solves it, so this dumps
        the exact same matrix trilinos_->K would otherwise hold, so no new
        dump code is needed on this side.

        Comparison result: FEDDLib's tangent at this same physical state
        (first Newton iteration, first load step) was ~16% asymmetric,
        while svMultiPhysics's was symmetric to machine precision
        (2.5e-16), despite both using the same follower-pressure inner-
        wall BC. Traced to a real bug: read_files.cpp's lBc.flwP gate
        (which physics types get real follower-pressure treatment) never
        included Equation_defdiff, so def_diffu's "follower" pressure was
        silently falling back to a fixed-direction dead load (no pressure-
        stiffness/Nanson's-formula linearization at all), consistent
        with the exact symmetry, and a well-known source of Newton
        instability under inflating-surface loading (the fixed load
        direction stops making physical sense as the wall balloons and
        its true normal rotates away). Also, eq_assem.cpp's b_neu_folw_p
        had no phys_def_diffu case at all. Both fixed: flwP gate now
        includes Equation_defdiff, and b_neu_folw_p now routes
        phys_def_diffu through struct_ns::b_struct_3d/b_struct_2d (the
        same follower-pressure element formulation phys_struct uses,
        already written generically against eq.s/com_mod.dof rather than
        a hardcoded dof=3, so it needed no adaptation for def_diffu's
        dof=4 layout). Switched back to "trilinos-amesos2" (exact direct
        solve) to test whether this fix alone resolves the iteration-1-3
        divergence, independent of any preconditioner/GMRES question. -->
   <LS type="GMRES" >
      <Linear_algebra type="trilinos" >
         <Preconditioner> trilinos-amesos2 </Preconditioner>
      </Linear_algebra>
      <Tolerance> 1e-6 </Tolerance>
      <Max_iterations> 100 </Max_iterations>
      <Krylov_space_dimension> 50 </Krylov_space_dimension>
   </LS>

   <!-- Statically-determinate constraint set (a plain or Effective_direction
        Dir BC on this dof=nsd+1 equation only ever touches the 3 spatial
        displacement components; the concentration dof cannot be
        Dirichlet-constrained at all in the current implementation, see the
        accompanying report):
        - both end faces axially fixed (u_z=0) removes z-translation and
          bending/tilt rotation about the x and y axes (3 modes);
        - 3 points on the outer surface, evenly spaced in angle, each with
          its own local circumferential (tangential) direction pinned to
          zero, removes x/y translation and rotation about the axis (3
          modes); see generate_mesh.py's pick_circumferential_pin_nodes()
          for how these nodes/directions were computed. -->
   <Add_BC name="bottom" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 0, 1) </Effective_direction>
   </Add_BC>

   <Add_BC name="top" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 0, 1) </Effective_direction>
   </Add_BC>

   <Add_BC name="pin0" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 1, 0) </Effective_direction>
   </Add_BC>

   <Add_BC name="pin1" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (1, 0, 0) </Effective_direction>
   </Add_BC>

   <Add_BC name="pin2" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 1, 0) </Effective_direction>
   </Add_BC>

   <!-- Internal pressure, applied as a follower (deformed-configuration)
        load on the lumen wall. -->
   <Add_BC name="inner" >
      <Type> Neu </Type>
      <Time_dependence> Unsteady </Time_dependence>
      <Temporal_values_file_path> load.dat </Temporal_values_file_path>
      <Ramp_function> true </Ramp_function>
      <Follower_pressure_load> true </Follower_pressure_load>
   </Add_BC>

</Add_equation>

</svMultiPhysicsFile>
