<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> 50 </Number_of_time_steps>
  <Time_step_size> 0.2 </Time_step_size>
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 5 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>

  <Increment_in_saving_restart_files> 100 </Increment_in_saving_restart_files>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>

</GeneralSimulationParameters>

<Add_mesh name="msh" >
  <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>

  <Add_face name="bottom">
      <Face_file_path> mesh/mesh-surfaces/bottom.vtp </Face_file_path>
  </Add_face>

  <Add_face name="top">
      <Face_file_path> mesh/mesh-surfaces/top.vtp </Face_file_path>
  </Add_face>

  <Add_face name="outer">
      <Face_file_path> mesh/mesh-surfaces/outer.vtp </Face_file_path>
  </Add_face>

  <Add_face name="inner">
      <Face_file_path> mesh/mesh-surfaces/inner.vtp </Face_file_path>
  </Add_face>

  <Add_face name="pin0">
      <Face_file_path> mesh/mesh-surfaces/pin0.vtp </Face_file_path>
  </Add_face>

  <Add_face name="pin1">
      <Face_file_path> mesh/mesh-surfaces/pin1.vtp </Face_file_path>
  </Add_face>

  <Add_face name="pin2">
      <Face_file_path> mesh/mesh-surfaces/pin2.vtp </Face_file_path>
  </Add_face>

  <Mesh_scale_factor> 1.0 </Mesh_scale_factor>
  <Initial_displacements_file_path> mesh/initial_displacement.vtu </Initial_displacements_file_path>
</Add_mesh>

<Add_equation type="deformation-diffusion" >

   <Coupled> true </Coupled>
   <Min_iterations> 1 </Min_iterations>
   <Max_iterations> 25 </Max_iterations>
   <Tolerance> 1e-5 </Tolerance>

   <Integration_code> 18 </Integration_code>
   <Subiteration_tolerance> 1e-7 </Subiteration_tolerance>

   <CCBActiveCMMGandR>
     <fA> 30 </fA>
     <kEtaPlus> 0.6 </kEtaPlus>
     <mEtaPlus> 5 </mEtaPlus>
     <Alpha1> 11.52507 </Alpha1>
     <Alpha2> 151.73775 </Alpha2>
     <Alpha3> 2.75662 </Alpha3>
     <Alpha4> 1.27631 </Alpha4>
     <Alpha5> 3.08798 </Alpha5>
     <GroundGrowthBool> 0 </GroundGrowthBool>
     <ReorientationBool> 0 </ReorientationBool>
     <CollRemodelingBool> 0 </CollRemodelingBool>
     <Density> 1 </Density>
     <ElastinFrac> 0.370370370 </ElastinFrac>
     <CollagenFrac> 0.370370370 </CollagenFrac>
     <TElastin> 1000 </TElastin>
     <TCollagen> 1000 </TCollagen>
     <KElastin> 1 </KElastin>
     <KCollagen> 1 </KCollagen>
     <IHomo> 50 </IHomo>
     <QMax> 1 </QMax>
     <QMin> 0.2 </QMin>
     <AlphaMech> 1 </AlphaMech>
     <PCirc> 1 </PCirc>
     <PAx> 1 </PAx>
     <PRad> 1 </PRad>
     <GNInit> 1.008 </GNInit>
     <TC> 1000 </TC>
     <LambdaC50> 1.2 </LambdaC50>
     <Gamma3Max> 0.9 </Gamma3Max>
     <LambdaBarCDotMax> 0.0443 </LambdaBarCDotMax>
     <LambdaBarCDotMin> -0.0443 </LambdaBarCDotMin>
     <Gamma2> 50 </Gamma2>
     <Gamma1Max> 0.5131 </Gamma1Max>
     <Eta> 0.1624 </Eta>
     <Ca50> 0.4 </Ca50>
     <K3> 0.134 </K3>
     <K4> 0.00166 </K4>
     <K7> 6.6e-05 </K7>
     <Kappa> 148.262 </Kappa>
     <Beta1> 0.001006 </Beta1>
     <MuA> 11.857 </MuA>
     <Beta2> 26.68 </Beta2>
     <Gamma6> 1.5 </Gamma6>
     <LambdaP50> 1 </LambdaP50>
     <KDotMin> -0.0010694 </KDotMin>
     <Zeta1> 100 </Zeta1>
     <KDotMax> 0.0009735 </KDotMax>
     <Gamma4> 200 </Gamma4>
     <LambdaBarDotPMin> -0.0002323 </LambdaBarDotPMin>
     <LambdaBarDotPMax> 6.99e-05 </LambdaBarDotPMax>
     <Gamma5> 50 </Gamma5>
     <Zeta2> 1000 </Zeta2>
     <DeltaLambdaBarPMin> -1e-05 </DeltaLambdaBarPMin>
     <Gamma1Min> 0.0779791039 </Gamma1Min>
     <Gamma3Min> 0.136778783 </Gamma3Min>
     <C50> 0.6673453236 </C50>
     <D0> 6e-05 </D0>
     <M> 0 </M>
     <ActiveStartTime> 1000 </ActiveStartTime>
     <KMin> 0.15 </KMin>
     <ActiveBool> 0 </ActiveBool>
     <kFiberDistribution> 0.1333333333 </kFiberDistribution>
     <P> 2.958083521 </P>
     <TSMC> 1000 </TSMC>
     <SMCFrac> 0.259259259 </SMCFrac>
     <NCOpt> 0.6 </NCOpt>
     <AlphaBio> 1 </AlphaBio>
     <KSMC> 1 </KSMC>
     <SMCGrowthBool> 0 </SMCGrowthBool>
     <PostProcessingType> 1 </PostProcessingType>
     <PostProcessingPower> 1 </PostProcessingPower>
   </CCBActiveCMMGandR>

   <Output type="Spatial" >
     <Displacement> true </Displacement>
     <Concentration> true </Concentration>
   </Output>

   <!-- FSILS's own "rcs" preconditioner (diagonal row/column scaling) was
        verified to reduce this system's raw condition number from ~1.3e9
        to ~4.5e5, which is still far too large for GMRES to resolve
        within a practical iteration budget; confirmed the structural
        block alone (with the decoupled diffusion block removed entirely)
        already has this same ~5e5 conditioning, so it's intrinsic to the
        large-strain anisotropic CCB tangent itself, not something a
        diagonal-only preconditioner can fix. Switched to the Trilinos
        backend; requires building with -DSV_USE_TRILINOS=ON and
        -DCMAKE_PREFIX_PATH=<path-to-trilinos>/lib/cmake/Trilinos.
        Tried "trilinos-ml" (MueLu algebraic multigrid) first, the
        preconditioner svMultiPhysics's own docs (Code/Source/solver/
        README-trilinos.md) recommend for displacement-based structural
        problems, but it still failed to converge within 100 GMRES
        iterations even once genuinely engaged (confirmed via its own
        verbose parameter dump); likely because setMueLuPreconditioner()'s
        hardcoded defaults (Code/Source/solver/trilinos_impl.cpp) are
        tuned for FSI, and its "number of equations"=dof=4 amalgamation
        assumes uniform-physics dof, whereas this system mixes 3 elastic
        components with 1 unrelated (fully decoupled) diffusion dof under
        that same block size, likely confusing AMG's aggregation/nullspace
        logic. Switched to "trilinos-ilut" (ILU with fill threshold, via
        additive Schwarz), which per the same docs is far less sensitive
        to this kind of problem-structure mismatch than AMG. If this also
        doesn't converge well, "trilinos-riluk0" is the next thing to try. -->
   <LS type="GMRES" >
      <Linear_algebra type="trilinos" >
         <Preconditioner> trilinos-ilut </Preconditioner>
      </Linear_algebra>
      <Tolerance> 1e-6 </Tolerance>
      <Max_iterations> 100 </Max_iterations>
      <Krylov_space_dimension> 50 </Krylov_space_dimension>
   </LS>

   <!-- Statically-determinate constraint set (a plain or Effective_direction
        Dir BC on this dof=nsd+1 equation only ever touches the 3 spatial
        displacement components; the concentration dof cannot be
        Dirichlet-constrained at all in the current implementation, see the
        accompanying report):
        - both end faces axially fixed (u_z=0) removes z-translation and
          bending/tilt rotation about the x and y axes (3 modes);
        - 3 points on the outer surface, evenly spaced in angle, each with
          its own local circumferential (tangential) direction pinned to
          zero, removes x/y translation and rotation about the axis (3
          modes); see generate_mesh.py's pick_circumferential_pin_nodes()
          for how these nodes/directions were computed. -->
   <Add_BC name="bottom" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 0, 1) </Effective_direction>
   </Add_BC>

   <Add_BC name="top" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 0, 1) </Effective_direction>
   </Add_BC>

   <Add_BC name="pin0" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 1, 0) </Effective_direction>
   </Add_BC>

   <Add_BC name="pin1" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (1, 0, 0) </Effective_direction>
   </Add_BC>

   <Add_BC name="pin2" >
      <Type> Dir </Type>
      <Value> 0.0 </Value>
      <Effective_direction> (0, 1, 0) </Effective_direction>
   </Add_BC>

   <!-- Internal pressure, applied as a follower (deformed-configuration)
        load on the lumen wall. -->
   <Add_BC name="inner" >
      <Type> Neu </Type>
      <Time_dependence> Unsteady </Time_dependence>
      <Temporal_values_file_path> load.dat </Temporal_values_file_path>
      <Ramp_function> true </Ramp_function>
      <Follower_pressure_load> true </Follower_pressure_load>
   </Add_BC>

</Add_equation>

</svMultiPhysicsFile>
